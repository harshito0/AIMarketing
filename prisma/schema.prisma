datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  role       String   @default("TEAM")
  avatar     String
  title      String
  department String?  @default("Development")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  auditLogs AuditLog[]
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  headId      String?
  headName    String?
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Employee {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  name          String
  email         String   @unique
  phone         String?
  department    String
  designation   String
  role          String   @default("EMPLOYEE") // SUPER_ADMIN, DEPT_HEAD, EMPLOYEE
  managerId     String?
  managerName   String?
  joiningDate   String
  status        String   @default("ACTIVE")   // ACTIVE, ON_LEAVE, INACTIVE
  avatar        String?
  workloadScore Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Lead {
  id                String    @id @default(cuid())
  leadCode          String    @unique
  contactName       String
  company           String
  phone             String
  email             String
  service           String
  source            String    @default("Website")
  status            String    @default("NEW") // NEW, CONTACTED, INTERESTED, REQUIREMENT, QUOTATION, NEGOTIATION, WON, LOST
  assignedToId      String?
  assignedToName    String?
  lastContactDate   String?
  nextFollowUpDate  String?
  estimatedValue    Float     @default(0)
  requirementNotes  String?
  convertedClientId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Client {
  id            String   @id @default(cuid())
  name          String
  businessName  String
  website       String
  industry      String
  country       String
  province      String
  city          String
  contactName   String
  contactEmail  String
  contactPhone  String?  @default("")
  clientCode    String?  @default("")
  githubRepo    String?  @default("")
  deploymentUrl String?  @default("")
  status        String?  @default("ACTIVE")
  description   String
  brandTone     String
  logoUrl       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaigns          Campaign[]
  projects           Project[]
  socialAccounts     SocialAccount[]
  socialPosts        SocialPost[]
  socialActivityLogs SocialActivityLog[]
  socialConfig       SocialClientConfig?
  conversations      Conversation[]
}

model Project {
  id              String      @id @default(cuid())
  projectCode     String      @unique
  name            String
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id])
  clientName      String
  service         String
  department      String      @default("Development")
  managerId       String?
  managerName     String?
  teamMembersJson String?     @default("[]")
  startDate       String
  deadline        String
  progress        Int         @default(0)
  health          String      @default("ON_TRACK") // ON_TRACK, AT_RISK, DELAYED
  status          String      @default("ACTIVE")   // ACTIVE, IN_REVIEW, COMPLETED, ON_HOLD
  description     String
  priority        String      @default("MEDIUM")
  billingTotal    Float       @default(0)
  billingPaid     Float       @default(0)
  gitRepoUrl      String?
  liveUrl         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  milestones      Milestone[]
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int       @default(1)
  dueDate     String
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id              String   @id @default(cuid())
  title           String
  description     String
  priority        String   @default("MEDIUM") // URGENT, HIGH, MEDIUM, LOW
  status          String   @default("TODO")   // TODO, IN_PROGRESS, REVIEW, COMPLETED, BLOCKED
  assignedToId    String
  assignedToName  String
  assignedToEmail String
  assignedById    String
  assignedByName  String
  clientId        String?
  clientName      String?
  campaignId      String?
  campaignName    String?
  projectId       String?
  projectName     String?
  sopRef          String?
  proofUrl        String?
  githubLink      String?
  estimatedHours  Float?
  dueDate         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WorkLog {
  id              String   @id @default(cuid())
  employeeId      String
  employeeName    String
  employeeEmail   String
  projectId       String?
  projectName     String?
  taskId          String?
  taskTitle       String?
  date            String
  workCompleted   String
  timeSpentHours  Float    @default(0)
  proofUrl        String?
  blocker         String?
  tomorrowPlan    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SOP {
  id                    String   @id @default(cuid())
  code                  String   @unique
  title                 String
  department            String
  service               String
  purpose               String
  instructions          String
  checklistJson         String   @default("[]")
  requiredProof         String?
  expectedDurationHours Float    @default(0)
  responsibleRole       String   @default("EMPLOYEE")
  version               String   @default("1.0")
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Quotation {
  id                  String   @id @default(cuid())
  quotationNumber     String   @unique
  prefix              String?  @default("Q")
  suffix              String?  @default("")
  date                String
  validUntil          String?
  clientId            String?
  clientName          String
  clientPhone         String?
  clientEmail         String?
  clientGstin         String?
  billingAddress      String?
  itemsJson           String   @default("[]")
  subtotal            Float    @default(0)
  taxableAmount       Float?   @default(0)
  cgst                Float?   @default(0)
  sgst                Float?   @default(0)
  igst                Float?   @default(0)
  taxAmount           Float    @default(0)
  discountBeforeTax   Float?   @default(0)
  discountAfterTax    Float?   @default(0)
  serviceCharge       Float?   @default(0)
  otherCharges        Float?   @default(0)
  roundOff            Float?   @default(0)
  autoRoundOff        Boolean? @default(true)
  totalAmount         Float    @default(0)
  currency            String   @default("INR")
  status              String   @default("DRAFT") // DRAFT, SENT, VIEWED, ACCEPTED, REJECTED, EXPIRED
  notes               String?
  bankDetails         String?
  terms               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Invoice {
  id                    String   @id @default(cuid())
  invoiceNumber         String   @unique
  quotationId           String?
  date                  String
  dueDate               String
  clientId              String
  clientName            String
  clientGstin           String?
  billingAddress        String?
  itemsJson             String   @default("[]")
  subtotal              Float    @default(0)
  taxableAmount         Float?   @default(0)
  cgst                  Float    @default(0)
  sgst                  Float    @default(0)
  igst                  Float    @default(0)
  totalAmount           Float    @default(0)
  amountPaid            Float    @default(0)
  balanceDue            Float    @default(0)
  currency              String   @default("INR")
  status                String   @default("DRAFT") // DRAFT, SENT, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  paymentMethod         String?
  razorpayPaymentLinkId String?
  razorpayPaymentId     String?
  notes                 String?
  terms                 String?
  seriesName            String?  @default("Sales Invoice")
  invoicePrefix         String?  @default("INV")
  invoiceSuffix         String?  @default("")
  bookName              String?  @default("Sales Taxable")
  shippingAddress       String?
  quotationNo           String?
  placeOfSupply         String?
  rateType              String?  @default("EXCLUSIVE_GST")
  discountType          String?  @default("PERCENTAGE")
  discountValue         Float?   @default(0)
  discountAmount        Float?   @default(0)
  serviceCharge         Float?   @default(0)
  otherCharges          Float?   @default(0)
  roundOff              Float?   @default(0)
  bankDetailsJson       String?
  paymentDetailsJson    String?
  customFieldsJson      String?  @default("[]")
  attachmentUrl         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Expense {
  id            String   @id @default(cuid())
  date          String
  category      String   // SOFTWARE, ADVERTISING, HOSTING, OFFICE, TRAVEL, VENDOR, OTHER
  vendor        String
  amount        Float    @default(0)
  gstAmount     Float    @default(0)
  paymentMethod String   @default("Bank Transfer")
  description   String
  attachmentUrl String?
  department    String   @default("Management")
  projectId     String?
  projectName   String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MarketingContent {
  id          String   @id @default(cuid())
  clientId    String
  clientName  String
  campaignId  String?
  platform    String   @default("Instagram") // Instagram, Facebook, LinkedIn, Google, YouTube
  contentType String   @default("Post")      // Post, Reel, Story, Ad Banner, Video
  title       String
  caption     String?
  creativeUrl String?
  status      String   @default("PLANNED")  // PLANNED, IN_REVIEW, APPROVED, PUBLISHED
  publishDate String
  resultsJson String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Campaign {
  id                  String         @id @default(cuid())
  name                String
  clientId            String
  client              Client         @relation(fields: [clientId], references: [id])
  objective           String
  platform            String         @default("Google Ads")
  location            String
  dailyBudget         Float
  totalBudget         Float
  currency            String         @default("CAD")
  status              String         @default("DRAFT")
  startDate           String
  endDate             String
  googleAdsCampaignId String?
  approvedBy          String?
  approvedAt          String?
  metricsSpend        Float          @default(0)
  metricsImpressions  Int            @default(0)
  metricsClicks       Int            @default(0)
  metricsCtr          Float          @default(0)
  metricsCpc          Float          @default(0)
  metricsConversions  Int            @default(0)
  metricsCpa          Float          @default(0)
  metricsConvRate     Float          @default(0)
  aiInsight           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  brief               CampaignBrief?
  proposal            CampaignProposal?
  creatives           Creative[]
  agentRuns           AgentRun[]
  auditLogs           AuditLog[]
}

model Creative {
  id           String    @id @default(cuid())
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title        String
  type         String    @default("IMAGE")
  provider     String    @default("Gemini")
  model        String    @default("gemini-3.6-flash")
  prompt       String
  aspectRatio  String    @default("1:1")
  imageUrl     String
  thumbnailUrl String?
  status       String    @default("FINAL")
  metadataJson String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CampaignBrief {
  id                 String   @id @default(cuid())
  campaignId         String   @unique
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productService     String
  serviceDescription String
  websiteUrl         String
  landingPageUrl     String
  offer              String
  cta                String
  targetCountry      String
  targetProvince     String
  targetCity         String
  targetLanguage     String
  aiRequirements     String
  createdAt          DateTime @default(now())
}

model CampaignProposal {
  id                   String   @id @default(cuid())
  campaignId           String   @unique
  campaign             Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId             String
  clientName           String
  objective            String
  location             String
  recommendedBudgetCAD Float
  platform             String
  audienceJson         String
  strategyJson         String
  copyJson             String
  creativesJson        String
  qualityCheckJson     String
  createdAt            DateTime @default(now())
}

model AgentRun {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  agentName   String
  status      String
  outputJson  String?
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model AuditLog {
  id           String    @id @default(cuid())
  timestamp    DateTime  @default(now())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  userName     String?
  agentName    String?
  action       String
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id])
  campaignName String?
  apiOperation String?
  status       String
  details      String
}

model AISetting {
  id                 String  @id @default("default")
  strategyProvider   String  @default("OpenAI")
  researchProvider   String  @default("Gemini")
  copyProvider       String  @default("OpenAI")
  imageProvider      String  @default("OpenAI")
  videoProvider      String  @default("Gemini")
  validationProvider String  @default("Gemini")
  demoMode           Boolean @default(true)
}

model ConnectionStatus {
  id                   String  @id @default("default")
  openAiConnected      Boolean @default(true)
  geminiConnected      Boolean @default(true)
  googleAdsConnected   Boolean @default(true)
  googleAdsCustomerId  String? @default("849-204-9102")
  googleAdsAccountName String? @default("G1 Sphere Canada Ads")
}

model Invitation {
  id            String   @id @default(cuid())
  email         String
  name          String?
  role          String   @default("TEAM_MEMBER")
  department    String?  @default("Development")
  passcode      String   @unique
  tokenHash     String?
  invitedBy     String?
  invitedByName String?
  status        String   @default("PENDING")
  message       String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ScreenTimeLog {
  id            String   @id @default(cuid())
  userId        String
  userName      String
  userEmail     String
  date          String   // e.g. "2026-08-26"
  activeSeconds Int      @default(0)
  sessionCount  Int      @default(1)
  lastActiveAt  DateTime @default(now())
  firstLoginAt  DateTime @default(now())
  pageBreakdown String?  // JSON string e.g. {"/dashboard": 1200, "/tasks": 800}
  deviceInfo    String?  // e.g. "Windows PC (Desktop)"
  status        String   @default("ACTIVE") // ACTIVE, IDLE, OFFLINE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
}

model SocialAccount {
  id                String    @id @default(cuid())
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform          String    // INSTAGRAM, FACEBOOK
  accountType       String    @default("PROFESSIONAL") // PROFESSIONAL, PAGE, BUSINESS
  accountId         String    // Meta Page ID or IG User ID
  username          String    // e.g. @auravitalstar
  pageName          String?   // e.g. Aura Vital Star
  profilePictureUrl String?
  encryptedToken    String?   // Server-side securely encrypted access token
  tokenExpiresAt    DateTime?
  isConnected       Boolean   @default(true)
  connectionHealth  String    @default("HEALTHY") // HEALTHY, WARNING, EXPIRED, DISCONNECTED
  healthMessage     String?
  connectedById     String?
  connectedByName   String?
  lastSyncAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([clientId, platform, accountId])
}

model SocialPost {
  id              String                 @id @default(cuid())
  clientId        String
  client          Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdById     String
  createdByName   String
  createdByEmail  String?
  platformsJson   String                 @default("[\"INSTAGRAM\",\"FACEBOOK\"]") // Array of platforms
  caption         String
  hashtagsJson    String                 @default("[]") // Array of hashtags
  location        String?
  locationJson    String?
  mediaJson       String                 @default("[]") // [{url, type, name, size, width, height}]
  musicJson       String?                // {title, artist, previewUrl, isInstagramAudioWarning}
  status          String                 @default("DRAFT") // DRAFT, READY, SCHEDULED, PUBLISHING, PUBLISHED, FAILED
  scheduledAt     DateTime?
  publishedAt     DateTime?
  failureReason   String?
  lastEditedById  String?
  lastEditedByName String?
  lastEditedAt    DateTime?
  isLocked        Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  attempts        SocialPublishAttempt[]
}

model SocialPublishAttempt {
  id             String      @id @default(cuid())
  postId         String
  post           SocialPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform       String      // INSTAGRAM, FACEBOOK
  attemptNumber  Int         @default(1)
  status         String      // SUCCESS, FAILED, RETRY
  responsePayload String?
  errorMessage   String?
  platformPostId String?
  platformPostUrl String?
  attemptedAt    DateTime    @default(now())
}

model SocialActivityLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  postId    String?
  action    String   // e.g. "Harshit created a post", "Priya scheduled post"
  userId    String
  userName  String
  details   String?
  platform  String?
  timestamp DateTime @default(now())
}

model SocialClientConfig {
  id                  String   @id @default(cuid())
  clientId            String   @unique
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  defaultLocation     String   @default("Aura Vital Star, Brampton")
  defaultTimezone     String   @default("Asia/Kolkata")
  brandTone           String   @default("Inspiring, Engaging, Professional")
  defaultHashtagsJson String   @default("[]")
  autoHashtags        Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Conversation {
  id            String               @id @default(cuid())
  clientId      String?
  client        Client?              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientName    String?
  name          String
  type          String               @default("GROUP") // DIRECT, GROUP
  avatarUrl     String?
  createdById   String
  createdByName String
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  members       ConversationMember[]
  messages      Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  userName       String
  userEmail      String
  userAvatar     String?
  role           String       @default("MEMBER") // ADMIN, MEMBER
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderName     String
  senderEmail    String?
  senderAvatar   String?
  content        String
  messageType    String        @default("TEXT") // TEXT, IMAGE, FILE
  attachmentUrl  String?
  attachmentName String?
  attachmentSize Int?
  isEdited       Boolean       @default(false)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  reads          MessageRead[]
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  date        String
  time        String?  @default("10:00 AM")
  type        String   @default("PROJECT") // CRM, SALES, PROJECT, FINANCE, MARKETING
  priority    String   @default("MEDIUM")  // HIGH, MEDIUM, LOW
  description String?  @default("")
  status      String   @default("PENDING") // PENDING, COMPLETED, IN_PROGRESS
  color       String?  @default("bg-blue-100 text-blue-800")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
